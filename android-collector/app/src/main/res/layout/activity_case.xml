<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="@android:color/black"
            android:textSize="36sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Case Detail"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/nav_icon"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/orderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/brand_soft"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order Details"
                            android:textColor="@color/brand_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtOrderNo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.35"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="4">

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Case No." />
                            <TextView android:id="@+id/txtCaseNo" style="@style/Collector.DetailValue" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="App Name (Product Name)" />
                            <TextView android:id="@+id/txtProduct" style="@style/Collector.DetailValueStrong" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Overdue Days" />
                            <TextView android:id="@+id/txtOverdueDays" style="@style/Collector.DetailValueDanger" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Collection Status" />
                            <TextView android:id="@+id/txtCollectionStatus" style="@style/Collector.DetailValue" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Due Date" />
                            <TextView android:id="@+id/txtDueDate" style="@style/Collector.DetailValue" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Total Loan" />
                            <TextView android:id="@+id/txtTotalLoan" style="@style/Collector.DetailValue" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Total Repaid" />
                            <TextView android:id="@+id/txtTotalRepaid" style="@style/Collector.DetailValueSuccess" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Collector.DetailCell">
                            <TextView style="@style/Collector.DetailLabel" android:text="Device Status" />
                            <TextView android:id="@+id/txtDeviceStatus" style="@style/Collector.DetailValue" />
                        </LinearLayout>
                    </GridLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:background="@drawable/bg_due_panel"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Current due amount"
                            android:textColor="@color/danger"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCurrentDue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/danger"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDueHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/customerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtCustomer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/success"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_status_pill"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Open case"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@android:color/black"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnWhatsapp"
                            style="@style/Collector.ContactIcon"
                            android:text="WA"
                            android:textColor="@color/success" />

                        <TextView
                            android:id="@+id/btnCall"
                            style="@style/Collector.ContactIcon"
                            android:layout_marginStart="10dp"
                            android:text="Call"
                            android:textColor="@color/brand" />

                        <TextView
                            android:id="@+id/btnSms"
                            style="@style/Collector.ContactIcon"
                            android:layout_marginStart="10dp"
                            android:text="SMS"
                            android:textColor="@color/orange_action" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Collector.DetailLabel" android:text="Wallet No." />
                            <TextView android:id="@+id/txtWalletNo" style="@style/Collector.DetailValueStrong" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/Collector.DetailLabel" android:text="WhatsApp" />
                            <TextView android:id="@+id/txtWhatsappNo" style="@style/Collector.DetailValueStrong" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Wallet Operator"
                        android:textColor="@color/muted_soft"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtWalletOperator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnFullPayment"
                            style="@style/Collector.ActionButton"
                            android:background="@drawable/bg_action_green"
                            android:text="Full payment" />

                        <TextView
                            android:id="@+id/btnPartialPay"
                            style="@style/Collector.ActionButton"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_action_orange"
                            android:text="Partial Pay" />

                        <TextView
                            android:id="@+id/btnExtension"
                            style="@style/Collector.ActionButton"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_action_amber"
                            android:text="Extension" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_detail_section"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:background="#FAFBFE"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabRecords"
                            style="@style/Collector.Tab"
                            android:text="Collection\nRecords" />
                        <TextView
                            android:id="@+id/tabCustomer"
                            style="@style/Collector.Tab"
                            android:text="Customer\nInformation" />
                        <TextView
                            android:id="@+id/tabContacts"
                            style="@style/Collector.Tab"
                            android:text="Contact List" />
                        <TextView
                            android:id="@+id/tabRepayments"
                            style="@style/Collector.Tab"
                            android:text="Repayment\nRecords" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/panelRecords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp" />

                    <LinearLayout
                        android:id="@+id/panelCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/panelContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/panelRepayments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/btnPreviousCase"
            style="@style/Collector.BottomButton"
            android:text="Previous Case" />

        <TextView
            android:id="@+id/btnNextCase"
            style="@style/Collector.BottomButton"
            android:layout_marginStart="28dp"
            android:text="Next Case" />
    </LinearLayout>
</LinearLayout>
