# Copy to .env and fill in. Never commit the real .env.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
# App runtime + migrations. Isolation enforced by app-layer Prisma extension.
DATABASE_URL=postgresql://USER@localhost:5432/devicelock?schema=public
# Non-superuser role with RLS enforced (tenant-isolation test / hardening target).
RLS_DATABASE_URL=postgresql://devicelock_app:app_password@localhost:5432/devicelock?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Redis / queues (Phase 2+) ---
REDIS_URL=redis://localhost:6379

# --- Integrations (later phases) ---
BEEM_API_KEY=
BEEM_SECRET_KEY=
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# --- Email (Resend) ---
# Unset RESEND_API_KEY to stub emails in development (logged only).
RESEND_API_KEY=
EMAIL_FROM=Linda <noreply@linda.co.tz>
CLIENT_APP_URL=http://localhost:5173

