// Device-Lock SaaS — Postgres schema (Prisma)
// Multi-tenant: shared schema, every business-owned row carries `tenantId`.
// Tenant isolation is enforced in two layers:
//   1. App layer: a Prisma client extension injects `tenantId` from request context.
//   2. DB layer:  Postgres Row-Level Security policies keyed on `tenantId`
//                 (added via a raw SQL migration, see docs/DESIGN.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // platform operator (you) — not bound to a tenant
  COLLECTIONS_ADMIN // platform: manage collectors, assign cases across sellers
  MASTER_COLLECTOR // platform: manages a team of COLLECTORs assigned to them
  COLLECTOR // platform: follow up assigned collection cases only
  OWNER // owner of a credit shop
  MANAGER
  AGENT // front-desk staff who enrolls devices / takes payments
}

enum CollectionsPackage {
  STARTER // < 30 devices, per-device pricing
  GROWTH // 30–44 devices, flat monthly
  BUSINESS // 45–55 devices, flat monthly
}

enum CollectionsSubscriptionStatus {
  NONE
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum CollectionCaseStatus {
  OPEN
  IN_PROGRESS
  PROMISED
  PAID
  ESCALATED
  CLOSED
}

enum CollectionCaseSource {
  AUTO_OVERDUE
  MANUAL
  SELLER_HANDOFF
}

enum ContactChannel {
  CALL
  SMS
  WHATSAPP
}

enum ContactSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

/// How strongly we proved the contact happened (see plan §3A).
enum ContactVerificationStatus {
  NONE
  SELF_REPORTED
  ATTEMPTED
  DEVICE_LOG_MATCHED
  PROVIDER_VERIFIED
  NO_MATCH
  FAILED
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  COMPLETED
  PENDING_PROOF
}

enum PromiseToPayStatus {
  OPEN
  KEPT
  BROKEN
  CANCELLED
}

enum CollectionsInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  PAST_DUE
}

/// Marketing-site "Request a demo" leads (platform-scoped, not tenant-owned).
enum DemoRequestStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum DeviceStatus {
  PENDING_ENROLLMENT // token issued, agent not yet provisioned
  ACTIVE // enrolled, in good standing
  LOCKED // kiosk lock enforced (overdue)
  RELEASED // loan completed, management removed
  DEFAULTED // written off
  WIPED
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTER_ID
  DRIVING_LICENSE
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  MPESA
  TIGOPESA
  AIRTELMONEY
  CARD
  BANK
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum CommandType {
  LOCK
  UNLOCK
  RELEASE // loan fully paid: relinquish device-owner, hand device to customer
  REMIND // show a non-blocking reminder banner
  SYNC_POLICY // push new offline / grace settings
  WIPE // last resort, gated by role + policy
}

enum CommandStatus {
  QUEUED
  SENT // delivered to device (push or pulled at check-in)
  ACKED // agent confirmed execution
  FAILED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Tenant & identity
// ---------------------------------------------------------------------------

model Tenant {
  id                 String   @id @default(uuid())
  name               String
  country            String   @default("TZ")
  timezone           String   @default("Africa/Dar_es_Salaam")
  isActive           Boolean  @default(true)
  // Default lock policy applied to new devices (overridable per device).
  graceDays          Int      @default(3)
  maxOfflineDays     Int      @default(4)
  lockOnSimChange    Boolean  @default(true)
  billingPlan        String   @default("STARTER")
  subscriptionStatus String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users                   User[]
  customers               Customer[]
  devices                 Device[]
  loans                   Loan[]
  contracts               Contract[]
  installments            Installment[]
  payments                Payment[]
  callFollowUps           CallFollowUp[]
  callAttempts            CallAttempt[]
  billingInvoices         BillingInvoice[]
  commands                DeviceCommand[]
  events                  DeviceEvent[]
  enrollTokens            EnrollmentToken[]
  collectionsSubscription CollectionsSubscription?
  collectionCases         CollectionCase[]
  contactSessions         ContactSession[]
  communicationLogs       CommunicationLog[]
  promisesToPay           PromiseToPay[]
  collectionsInvoices     CollectionsInvoice[]
  demoRequests            DemoRequest[]

  @@index([isActive])
}

/// Inbound sales lead from the public marketing site demo form.
model DemoRequest {
  id              String            @id @default(uuid())
  fullName        String
  companyName     String
  phone           String
  email           String?
  /// Raw band from the form, e.g. "Fewer than 30" / "30 – 44".
  devicesPerMonth String?
  /// Suggested package from the band (STARTER | GROWTH | BUSINESS | ENTERPRISE).
  suggestedPackage String?
  message         String?
  status          DemoRequestStatus @default(NEW)
  adminNotes      String?
  /// Set when sales converts the lead into a seller tenant.
  convertedTenantId String?
  convertedTenant   Tenant?         @relation(fields: [convertedTenantId], references: [id], onDelete: SetNull)
  source          String            @default("website")
  userAgent       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contactedAt     DateTime?

  @@index([status, createdAt])
  @@index([phone])
}

model User {
  id           String    @id @default(uuid())
  // null for SUPER_ADMIN, COLLECTIONS_ADMIN, MASTER_COLLECTOR, COLLECTOR (platform operators)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(AGENT)
  isActive     Boolean   @default(true)
  // Phone the collector uses for BYOD follow-up (E.164 preferred).
  phone        String?
  /// COLLECTOR → MASTER_COLLECTOR who manages them (null = unassigned).
  managedById  String?
  managedBy    User?     @relation("CollectorTeam", fields: [managedById], references: [id], onDelete: SetNull)
  managedCollectors User[] @relation("CollectorTeam")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  issuedCommands          DeviceCommand[]           @relation("CommandIssuedBy")
  assignedCallFollowUps   CallFollowUp[]            @relation("CallAssignedTo")
  createdCallFollowUps    CallFollowUp[]            @relation("CallCreatedBy")
  callAttempts            CallAttempt[]
  refreshTokens           RefreshToken[]
  assignedCollectionCases CollectionCase[]          @relation("CaseAssignedTo")
  referredCollectionCases CollectionCase[]          @relation("CaseReferredBy")
  activatedSubscriptions  CollectionsSubscription[] @relation("SubscriptionActivatedBy")
  contactSessions         ContactSession[]          @relation("ContactCollector")
  communicationLogs       CommunicationLog[]        @relation("CommCollector")
  promisesToPay           PromiseToPay[]            @relation("PtpCreatedBy")
  workSessions            CollectorWorkSession[]
  dailyStats              CollectorDailyStat[]

  @@index([tenantId])
  @@index([role])
  @@index([managedById])
}

/// Clock-in / clock-out (primary source for "hours worked").
model CollectorWorkSession {
  id          String    @id @default(uuid())
  collectorId String
  collector   User      @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  source      String    @default("MANUAL_CLOCK") // MANUAL_CLOCK | AUTO_FROM_ACTIVITY
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([collectorId, startedAt])
  @@index([collectorId, endedAt])
}

/// Materialized daily rollup for collector KPIs (day / month / year reports).
model CollectorDailyStat {
  id                 String   @id @default(uuid())
  collectorId        String
  collector          User     @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  /// Calendar day (UTC date truncated to midnight).
  date               DateTime @db.Date
  callsCount         Int      @default(0)
  talkSeconds        Int      @default(0)
  smsCount           Int      @default(0)
  whatsappCount      Int      @default(0)
  followUpsCount     Int      @default(0)
  casesWorked        Int      @default(0)
  ptpCount           Int      @default(0)
  /// From work sessions that day (seconds).
  hoursWorkedSeconds Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([collectorId, date])
  @@index([date])
}

// Seller subscribes so platform collectors can work their overdue book.
model CollectionsSubscription {
  id            String                        @id @default(uuid())
  tenantId      String                        @unique
  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageCode   CollectionsPackage
  status        CollectionsSubscriptionStatus @default(PENDING)
  // Snapshot / limits at activation
  deviceBandMin Int
  deviceBandMax Int
  priceModel    String // PER_DEVICE | FLAT
  unitPrice     Decimal?                      @db.Decimal(14, 2) // per device (Starter)
  flatPrice     Decimal?                      @db.Decimal(14, 2) // Growth / Business
  currency      String                        @default("TZS")
  activatedAt   DateTime?
  activatedById String?
  activatedBy   User?                         @relation("SubscriptionActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  endsAt        DateTime?
  notes         String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  invoices CollectionsInvoice[]

  @@index([status])
}

/// Monthly invoice for managed collections service (separate from platform SaaS billing).
model CollectionsInvoice {
  id             String                   @id @default(uuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   CollectionsSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  packageCode    CollectionsPackage
  activeDevices  Int
  priceModel     String
  unitPrice      Decimal?                 @db.Decimal(14, 2)
  flatPrice      Decimal?                 @db.Decimal(14, 2)
  currency       String                   @default("TZS")
  subtotal       Decimal                  @db.Decimal(14, 2)
  total          Decimal                  @db.Decimal(14, 2)
  status         CollectionsInvoiceStatus @default(OPEN)
  lineItems      Json
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([tenantId, periodStart])
  @@index([status, dueDate])
}

// One open work unit per loan (overdue collection case), always tagged with seller tenant.
model CollectionCase {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId        String       @unique
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  status          CollectionCaseStatus @default(OPEN)
  source          CollectionCaseSource @default(AUTO_OVERDUE)
  daysOverdue     Int                  @default(0)
  amountDue       Decimal              @default(0) @db.Decimal(14, 2)
  currency        String               @default("TZS")
  followUpCount   Int                  @default(0)
  assignedToId    String?
  assignedTo      User?                @relation("CaseAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt      DateTime?
  lastContactedAt DateTime?
  nextActionAt    DateTime?
  closedAt        DateTime?
  closedReason    String?

  // Seller hand-off: the shop explicitly asked the platform to work this case.
  referredById String?
  referredBy   User?     @relation("CaseReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  referredAt   DateTime?
  referralNote String?

  // Admin-granted extension / penalty waiver (set from the dashboard).
  extensionApplied                Boolean   @default(false)
  penaltyInterestReductionEnabled Boolean   @default(false)
  penaltyInterestAmount           Decimal   @default(0) @db.Decimal(14, 2)
  waiverValidUntil                DateTime?
  originalOverdueAmount           Decimal?  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactSessions   ContactSession[]
  communicationLogs CommunicationLog[]
  promisesToPay     PromiseToPay[]

  @@index([tenantId, status])
  @@index([assignedToId, status])
  @@index([status, daysOverdue])
  @@index([nextActionAt])
}

/// System-initiated contact (must start here before Call/SMS/WhatsApp).
model ContactSession {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId      String
  case        CollectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  loanId      String
  customerId  String
  collectorId String
  collector   User           @relation("ContactCollector", fields: [collectorId], references: [id], onDelete: Cascade)

  channel            ContactChannel
  customerPhone      String
  collectorPhone     String?
  bodyPreview        String?
  status             ContactSessionStatus      @default(PENDING)
  verificationStatus ContactVerificationStatus @default(NONE)
  provider           String?
  providerRef        String?
  durationSeconds    Int?
  deviceMatchMeta    Json?
  launchUrl          String? // tel: / sms: / wa.me deep link for client
  initiatedAt        DateTime                  @default(now())
  expiresAt          DateTime
  completedAt        DateTime?
  outcomeNote        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  communicationLog CommunicationLog?

  @@index([tenantId, initiatedAt])
  @@index([caseId, initiatedAt])
  @@index([collectorId, status])
  @@index([status, expiresAt])
}

/// Unified timeline of call / SMS / WhatsApp per client/case.
model CommunicationLog {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId           String
  case             CollectionCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  loanId           String
  customerId       String
  contactSessionId String?         @unique
  contactSession   ContactSession? @relation(fields: [contactSessionId], references: [id], onDelete: SetNull)
  collectorId      String?
  collector        User?           @relation("CommCollector", fields: [collectorId], references: [id], onDelete: SetNull)

  channel            ContactChannel
  direction          CommunicationDirection    @default(OUTBOUND)
  status             CommunicationStatus       @default(PENDING_PROOF)
  verificationStatus ContactVerificationStatus @default(NONE)
  customerPhone      String?
  body               String?
  durationSeconds    Int?
  providerRef        String?
  metadata           Json?
  occurredAt         DateTime                  @default(now())
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([tenantId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([collectorId, occurredAt])
}

model PromiseToPay {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId         String
  case           CollectionCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  loanId         String
  customerId     String
  promisedAmount Decimal            @db.Decimal(14, 2)
  currency       String             @default("TZS")
  promisedAt     DateTime           @default(now())
  dueDate        DateTime
  status         PromiseToPayStatus @default(OPEN)
  notes          String?
  createdById    String?
  createdBy      User?              @relation("PtpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  keptPaymentId  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, dueDate])
  @@index([caseId, status])
  @@index([status, dueDate])
  @@index([createdById])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers, devices, financing
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String // primary mobile-money number
  /// National ID, voter ID, or driving licence number (value).
  nationalId String?
  /// Which document `nationalId` refers to.
  idDocumentType IdDocumentType?
  address    String?

  // KYC / employment info (collections staff app)
  idCardPhotoUrl String?
  selfiePhotoUrl String?
  occupation     String?
  employerName   String?
  employerPhone  String?
  monthlyIncome  Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices         Device[]
  loans           Loan[]
  contracts       Contract[]
  callFollowUps   CallFollowUp[]
  callAttempts    CallAttempt[]
  collectionCases CollectionCase[]
  // ContactSession / CommunicationLog / PromiseToPay keyed via case/loan; no reverse needed on Customer for MVP

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Device {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  imei         String
  serialNumber String?
  make         String?
  model        String?

  status         DeviceStatus @default(PENDING_ENROLLMENT)
  // Per-device overrides of the tenant policy (null => inherit tenant).
  graceDays      Int?
  maxOfflineDays Int?

  // Agent identity / push
  agentTokenHash         String?   @unique // hash of the device's auth token
  smsSecret              String?
  fcmToken               String? // for instant push commands
  lastCheckInAt          DateTime?
  lockedAt               DateTime?
  simIccid               String?
  simOperator            String?
  simCountryIso          String?
  simPhoneNumber         String?
  simFingerprint         String?
  approvedSimFingerprint String?
  simLastChangedAt       DateTime?
  simChangeApprovedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan            Loan?
  callFollowUps   CallFollowUp[]
  callAttempts    CallAttempt[]
  commands        DeviceCommand[]
  events          DeviceEvent[]
  enrollToken     EnrollmentToken?
  collectionCases CollectionCase[]

  @@unique([tenantId, imei])
  @@index([tenantId, status])
  @@index([lastCheckInAt])
}

model EnrollmentToken {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId   String    @unique
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  token      String    @unique // embedded in the provisioning QR code
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model Loan {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId   String   @unique
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  principal    Decimal    @db.Decimal(14, 2) // device price financed
  downPayment  Decimal    @default(0) @db.Decimal(14, 2)
  interestRate Decimal    @default(0) @db.Decimal(5, 2) // % flat, simple model for MVP
  termMonths   Int
  currency     String     @default("TZS")
  status       LoanStatus @default(ACTIVE)
  startDate    DateTime   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments   Installment[]
  payments       Payment[]
  contract       Contract?
  callFollowUps  CallFollowUp[]
  callAttempts   CallAttempt[]
  collectionCase CollectionCase?

  @@index([tenantId, status])
}

model CallFollowUp {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("CallAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?   @relation("CallCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  outcome          String
  notes            String?
  promiseToPayAt   DateTime?
  escalationStatus String        @default("NONE")
  nextFollowUpAt   DateTime?
  calledAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attempts         CallAttempt[]

  @@index([tenantId, calledAt])
  @@index([tenantId, escalationStatus])
  @@index([loanId, calledAt])
}

model CallAttempt {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  followUpId String?
  followUp   CallFollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId     String
  loan       Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  staffId    String
  staff      User          @relation(fields: [staffId], references: [id], onDelete: Cascade)

  staffPhone         String?
  customerPhone      String
  provider           String?
  providerCallId     String?
  providerStatus     String?
  verificationStatus String    @default("SELF_REPORTED")
  durationSeconds    Int?
  recordingUrl       String?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  rawPayload         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, startedAt])
  @@index([staffId, startedAt])
  @@index([loanId, startedAt])
  @@index([providerCallId])
}

model Contract {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId     String   @unique
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  acceptedAt   DateTime @default(now())
  acceptedBy   String
  language     String   @default("en")
  termsVersion String   @default("simulinda-v1")
  termsText    String
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, acceptedAt])
  @@index([customerId])
}

model Installment {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId     String
  loan       Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  sequence   Int // 1..termMonths
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  amountPaid Decimal           @default(0) @db.Decimal(14, 2)
  status     InstallmentStatus @default(PENDING)
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionCases CollectionCase[]

  @@unique([loanId, sequence])
  @@index([tenantId, status, dueDate])
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId         String
  loan           Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  // Our unique reference sent to ClickPesa; matched back on the webhook.
  orderReference String?       @unique
  phoneNumber    String? // payer mobile-money number (mobile money only)
  providerRef    String?       @unique // ClickPesa transaction id (idempotency)
  rawPayload     Json? // original webhook body for audit/reconciliation
  receivedAt     DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

model BillingInvoice {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  planName        String
  status          String    @default("OPEN")
  currency        String    @default("TZS")
  activeDevices   Int       @default(0)
  smsCount        Int       @default(0)
  voiceCount      Int       @default(0)
  callCentreCount Int       @default(0)
  subtotal        Decimal   @db.Decimal(14, 2)
  tax             Decimal   @default(0) @db.Decimal(14, 2)
  total           Decimal   @db.Decimal(14, 2)
  paidAt          DateTime?
  lineItems       Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, periodStart])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Device control & audit
// ---------------------------------------------------------------------------

model DeviceCommand {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type       CommandType
  status     CommandStatus @default(QUEUED)
  reason     String? // e.g. "installment #3 overdue"
  issuedById String?
  issuedBy   User?         @relation("CommandIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  sentAt     DateTime?
  ackedAt    DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, deviceId, status])
}

// Append-only audit log: check-ins, lock/unlock results, policy changes.
model DeviceEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      String // CHECK_IN | LOCKED | UNLOCKED | ENROLLED | POLICY_SYNCED | ...
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, deviceId, createdAt])
}
