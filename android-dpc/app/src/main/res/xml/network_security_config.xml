<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. The API is served from api.linda.co.tz with a public CA
  certificate, so no cleartext exemption and no custom trust anchors are
  needed. Add <pin-set> here if you later want certificate pinning.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
